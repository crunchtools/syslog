[Unit]
Description=Podman container - syslog.crunchtools.com (Central Log Collector)
Documentation=https://github.com/crunchtools/syslog
Wants=network-online.target
After=network-online.target

# Senders reach the collector by three different routes, because the fleet is
# spread across three network types:
#   crunchtools network  -> the `syslog` network alias
#   podman network       -> 10.88.0.1:514 (the bridge gateway)
#   host network         -> 127.0.0.1:514
# The host's nftables policy already allows 10.88.0.0/16 and drops 514 from
# anywhere off-box.

[Service]
Type=simple
Restart=always
RestartSec=10
ExecStartPre=/usr/bin/sleep 1.5
ExecStartPre=-/usr/bin/podman rm -f syslog.crunchtools.com
# impstats writes straight to log.file and will not create its parent, and the
# bind mount hides whatever the image shipped at /logs.
ExecStartPre=/usr/bin/mkdir -p /srv/syslog.crunchtools.com/data/logs/_collector /srv/syslog.crunchtools.com/data/state
# --memory=512m, not 256m. At 256m the collector was OOM-killed inside its own
# cgroup (anon-rss 259 MB) while chewing through the initial journal backlog:
# imjournal reading a 3.9 GB journal with a 50k-message queue behind it. Steady
# state is ~18 MB, so this is headroom for the burst, not for the baseline.
# The health probe is what makes an imjournal stall self-healing. imjournal
# stops following the journal across a rotation -- rsyslogd stays up, its port
# stays open, its queue reports empty and healthy, and nothing is ingested.
# lotor rotates its journal every one to two hours, so this is routine.
#
# on-failure=kill rather than =restart: podman kills the container, the
# foreground `podman run` exits, and systemd's Restart=always brings it back.
# That keeps systemd the single owner of the lifecycle. The restart is lossless
# -- imjournal replays from its state-file cursor.
ExecStart=/usr/bin/podman run \
    --health-cmd /usr/bin/syslog-healthcheck \
    --health-interval 2m \
    --health-retries 2 \
    --health-start-period 90s \
    --health-on-failure kill \
    --label io.containers.autoupdate=registry \
    --label PODMAN_SYSTEMD_UNIT=syslog.crunchtools.com.service \
    --memory=512m --memory-swap=512m \
    --rm \
    --name syslog.crunchtools.com \
    --hostname syslog.crunchtools.com \
    --network crunchtools \
    --network-alias syslog \
    -p 127.0.0.1:514:514/udp \
    -p 127.0.0.1:514:514/tcp \
    -p 10.88.0.1:514:514/udp \
    -p 10.88.0.1:514:514/tcp \
    --security-opt label=type:container_logreader_t \
    -v /srv/syslog.crunchtools.com/config/rsyslog.conf:/etc/rsyslog.conf:ro,Z \
    -v /srv/syslog.crunchtools.com/data/logs:/logs:z \
    -v /srv/syslog.crunchtools.com/data/state:/var/lib/rsyslog:Z \
    -v /etc/machine-id:/etc/machine-id:ro \
    -e TZ=UTC \
    quay.io/crunchtools/syslog:latest
ExecStop=/usr/bin/podman stop -t 10 syslog.crunchtools.com
ExecStopPost=/usr/bin/podman rm -f syslog.crunchtools.com

[Install]
WantedBy=multi-user.target
